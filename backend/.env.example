APP_NAME=makeup-web
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL del SPA de Angular. Se usa para las redirecciones de Stripe Checkout
# y para el enlace de recuperacion de contrasena.
FRONTEND_URL=http://localhost:4200

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makeup_web
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Correo ──────────────────────────────────────────────────────────
# En local "log" escribe los correos en storage/logs en lugar de enviarlos.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@makeupbyyona.es"
MAIL_FROM_NAME="${APP_NAME}"
# Buzon que recibe los formularios de contacto y las reservas de cita.
MAIL_CONTACTO_DESTINO=info@makeupbyyona.es

# ─── CORS ────────────────────────────────────────────────────────────
# Lista separada por comas. Si se deja vacia se permiten los puertos de ng serve.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ─── Sanctum ─────────────────────────────────────────────────────────
# Minutos de vida de los tokens de API (30 dias por defecto).
SANCTUM_TOKEN_EXPIRATION=43200

# Minutos de validez del enlace de recuperacion de contrasena. Son 24h
# porque el correo de compra lo usa para que la persona elija su clave.
AUTH_PASSWORD_RESET_EXPIRE=1440

# ─── Stripe ──────────────────────────────────────────────────────────
# Claves del panel de Stripe. Sin STRIPE_SECRET el checkout no funciona y
# sin STRIPE_WEBHOOK_SECRET el webhook rechaza todo lo que le llegue.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# ID del precio (price_...) de la masterclass, lo usa el seeder.
STRIPE_PRICE_MASTERCLASS=
# Segundo price, el del importe de oferta (45 EUR). Stripe no permite
# cambiar el importe de un price, hacen falta dos objetos distintos.
STRIPE_PRICE_MASTERCLASS_OFERTA=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
