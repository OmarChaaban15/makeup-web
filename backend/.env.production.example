# Plantilla para el servidor de produccion (makeupbyyona.es).
# Copiar a .env, rellenar los valores y ejecutar: php artisan key:generate
#
# IMPORTANTE: .env NO se versiona. Este fichero solo documenta que variables
# hay que rellenar; no debe contener ningun secreto real.

APP_NAME="Makeup by Yona"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://makeupbyyona.es

FRONTEND_URL=https://makeupbyyona.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makeup_web
DB_USERNAME=makeup_web
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.makeupbyyona.es
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Correo ──────────────────────────────────────────────────────────
# Datos SMTP del proveedor (el hosting del dominio, Brevo, Resend, etc.).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@makeupbyyona.es"
MAIL_FROM_NAME="Makeup by Yona"
MAIL_CONTACTO_DESTINO=info@makeupbyyona.es

# ─── CORS ────────────────────────────────────────────────────────────
# El SPA se sirve desde el mismo dominio, pero se declara por si se separa.
CORS_ALLOWED_ORIGINS=https://makeupbyyona.es,https://www.makeupbyyona.es

# ─── Sanctum ─────────────────────────────────────────────────────────
SANCTUM_TOKEN_EXPIRATION=43200

# ─── Stripe (claves LIVE, no las de test) ────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
# Se obtiene al dar de alta el endpoint https://makeupbyyona.es/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MASTERCLASS=
